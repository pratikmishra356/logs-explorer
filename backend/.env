# Database (local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/logs_explorer

# App
APP_PORT=8003

# Splunk Cloud (cookie-based auth — will move to API token later)
SPLUNK_HOST=https://toast.splunkcloud.com
SPLUNK_COOKIE=REPLACE_WITH_YOUR_COOKIE
SPLUNK_CSRF_TOKEN=REPLACE_WITH_YOUR_CSRF_TOKEN
